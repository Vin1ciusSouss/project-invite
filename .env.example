# Copie este arquivo para .env. Em produção, use APP_ENV=production e uma chave longa e aleatória.
APP_ENV=development
# Endereco publico HTTPS usado nos QR Codes impressos (nunca localhost).
PUBLIC_SITE_URL=https://viniciussouss.pythonanywhere.com
SECRET_KEY=
DATABASE_URL=
# Diretório persistente para imagens enviadas pelo admin; deixe em branco para usar app/static/img/presentes localmente.
GIFT_UPLOAD_FOLDER=
# Gere um hash usando generate_password_hash do Werkzeug; nunca salve a senha em texto puro aqui.
ADMIN_PASSWORD_HASH=
